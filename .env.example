# ===========================================
# dockit 项目环境变量配置
# ===========================================
# 复制此文件为 .env 并填入实际值：
#   cp .env.example .env
# 然后修改 .env 里的密码和 API key

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change_me_root_pwd
MYSQL_DATABASE=doc_ai
# 应用连接 MySQL 用的账号（mysql-schema.sql 目前用 root，生产应建独立账号）
MYSQL_USERNAME=root
MYSQL_PASSWORD=change_me_root_pwd

# ---- Nacos（用 MySQL 存储配置） ----
# Nacos 访问 MySQL 的密码，需要和 mysql-schema.sql 里 nacos 用户的密码一致
NACOS_MYSQL_PASSWORD=dockit_nacos_123
# Nacos 控制台登录密码的 BCrypt hash，用于 mysql-schema.sql 初始化 nacos 用户
# 默认密码：nacos123
# 生成方式（任选其一）：
#   htpasswd -nbBC 10 "" "your_password" | tr -d ':\n' | sed 's/$2y/$2a/'
#   python -c "import bcrypt; print(bcrypt.hashpw(b'your_password', bcrypt.gensalt(10)).decode())"
NACOS_PASSWORD_HASH=$2a$10$N1pFS8lz2eSUBjEh020Wf.XXZSG9wu0lJgjFM4rwDL2ct.b3pluVm

# ---- Redis ----
REDIS_PASSWORD=change_me_redis_pwd

# ---- RabbitMQ ----
RABBITMQ_DEFAULT_USER=dockit
RABBITMQ_DEFAULT_PASS=change_me_rabbitmq_pwd
# 应用代码里用的 RabbitMQ 用户名/密码（通常和上面一致）
RABBITMQ_USERNAME=dockit
RABBITMQ_PASSWORD=change_me_rabbitmq_pwd

# ---- MinIO ----
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_me_minio_pwd
# 应用代码里用的 MinIO access/secret key（通常和 root 一致）
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=change_me_minio_pwd

# ---- AI 服务 API Key ----
# 阿里云 DashScope：用于 Embedding（text-embedding-v4）和 Rerank
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
# OpenAI 兼容接口：当前项目用于 DeepSeek 对话（模型 deepseek-v4-pro）
OPENAI_API_KEY=sk-your-deepseek-api-key
OPENAI_BASE_URL=https://api.deepseek.com

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_pwd
